<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <org.fossify.commons.views.MyAppBarLayout android:id="@+id/install_appbar"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/install_toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary" app:title="@string/app_backup_install"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />
    </org.fossify.commons.views.MyAppBarLayout>
    <LinearLayout android:id="@+id/install_content" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/install_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/app_install_preparing"
            android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/install_progress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal" />
        <Button android:id="@+id/install_confirm" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/app_install_confirm" android:enabled="false" />
    </LinearLayout>
</LinearLayout>
