<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <org.fossify.commons.views.MyAppBarLayout android:id="@+id/backup_appbar"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/backup_toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary" app:title="@string/app_backup_title"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />
    </org.fossify.commons.views.MyAppBarLayout>
    <LinearLayout android:id="@+id/backup_content" android:layout_width="match_parent"
        android:layout_height="match_parent" android:layout_below="@id/backup_appbar"
        android:orientation="vertical" android:padding="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_backup_description" />
        <Spinner android:id="@+id/backup_category" android:layout_width="match_parent"
            android:layout_height="48dp" android:contentDescription="@string/app_backup_category" />
        <EditText android:id="@+id/backup_search" android:layout_width="match_parent" android:layout_height="48dp"
            android:hint="@string/app_backup_search" android:inputType="text" android:maxLines="1"
            android:importantForAutofill="no" />
        <TextView android:id="@+id/backup_destination" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="middle" />
        <Button android:id="@+id/backup_select_all" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/app_backup_select_all" />
        <ListView android:id="@+id/backup_list" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:choiceMode="multipleChoice" />
        <TextView android:id="@+id/backup_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:maxLines="4"
            android:ellipsize="end" />
        <ProgressBar android:id="@+id/backup_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true"
            android:visibility="gone" />
        <Button android:id="@+id/backup_save" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/app_backup_save" />
        <Button android:id="@+id/backup_install" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/app_backup_install" />
    </LinearLayout>
</RelativeLayout>
